{
  "name": "@tensorix/metahub",
  "version": "0.2.2",
  "description": "Metahub core library and CLI",
  "license": "AGPL-3.0-only",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "metahub": "./dist/cli.js",
    "mh": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "README.zh-CN.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "bun --hot src/cli/index.ts",
    "build": "bun run scripts/build.ts",
    "build:shell": "bun run scripts/build-shell.ts",
    "build:share-viewer": "bun run scripts/build-share-viewer.ts",
    "build:binaries": "bun run scripts/compile-binaries.ts",
    "prepublishOnly": "bun run build",
    "test": "bun test",
    "release": "bun run scripts/tag-release.ts"
  },
  "dependencies": {
    "@clack/prompts": "^1.5.0",
    "@codemirror/commands": "^6.10.4",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/language": "^6.12.4",
    "@codemirror/search": "^6.7.1",
    "@codemirror/state": "^6.7.0",
    "@codemirror/view": "^6.43.4",
    "@sqlite.org/sqlite-wasm": "^3.53.0-build1",
    "aws4fetch": "^1.0.20",
    "citty": "^0.1.6",
    "codemirror": "^6.0.2",
    "highlight.js": "^11.11.1",
    "markdown-it": "^14.2.0",
    "preact": "^10.29.2",
    "prosemirror-commands": "^1.7.1",
    "prosemirror-dropcursor": "^1.8.2",
    "prosemirror-gapcursor": "^1.4.1",
    "prosemirror-history": "^1.5.0",
    "prosemirror-inputrules": "^1.5.1",
    "prosemirror-keymap": "^1.2.3",
    "prosemirror-markdown": "^1.13.4",
    "prosemirror-model": "^1.25.9",
    "prosemirror-schema-basic": "^1.2.4",
    "prosemirror-schema-list": "^1.5.1",
    "prosemirror-state": "^1.4.4",
    "prosemirror-tables": "^1.8.5",
    "prosemirror-view": "^1.41.9",
    "qrcode-generator": "^2.0.4",
    "turndown": "^7.2.4",
    "turndown-plugin-gfm": "^1.0.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^20.10.2",
    "@types/bun": "latest",
    "@types/turndown": "^5.0.6",
    "typescript": "^5"
  }
}
