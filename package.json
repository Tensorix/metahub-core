{
  "name": "@tensorix/metahub",
  "version": "0.1.11",
  "description": "Metahub core library and CLI",
  "license": "AGPL-3.0-only",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "metahub": "./dist/cli.js",
    "mh": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "README.zh-CN.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "bun --hot src/cli/index.ts",
    "build": "bun run scripts/build.ts",
    "build:binaries": "bun run scripts/compile-binaries.ts",
    "prepublishOnly": "bun run build",
    "test": "bun test",
    "release": "bun run scripts/tag-release.ts"
  },
  "dependencies": {
    "@clack/prompts": "^1.5.0",
    "@sqlite.org/sqlite-wasm": "^3.53.0-build1",
    "citty": "^0.1.6",
    "highlight.js": "^11.11.1",
    "preact": "^10.29.2",
    "turndown": "^7.2.4",
    "turndown-plugin-gfm": "^1.0.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^20.10.2",
    "@types/bun": "latest",
    "@types/turndown": "^5.0.6",
    "typescript": "^5"
  }
}
