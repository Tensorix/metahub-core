{
  "name": "@tensorix/metahub",
  "version": "0.3.0",
  "description": "Metahub core library and CLI",
  "license": "AGPL-3.0-only",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "metahub": "./dist/cli.js",
    "mh": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "README.zh-CN.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "bun --hot src/cli/index.ts",
    "build": "bun run scripts/build.ts",
    "build:shell": "bun run scripts/build-shell.ts",
    "build:share-viewer": "bun run scripts/build-share-viewer.ts",
    "build:binaries": "bun run scripts/compile-binaries.ts",
    "prepublishOnly": "bun run build",
    "test": "bun test",
    "release": "bun run scripts/tag-release.ts"
  },
  "dependencies": {
    "@clack/prompts": "^1.5.0",
    "@codemirror/commands": "6.10.4",
    "@codemirror/state": "6.7.0",
    "@codemirror/view": "6.43.4",
    "@sqlite.org/sqlite-wasm": "^3.53.0-build1",
    "aws4fetch": "^1.0.20",
    "citty": "^0.1.6",
    "highlight.js": "^11.11.1",
    "jsqr": "^1.4.0",
    "preact": "^10.29.2",
    "qrcode-generator": "^2.0.4",
    "turndown": "^7.2.4",
    "turndown-plugin-gfm": "^1.0.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^20.10.2",
    "@prettier/plugin-php": "^0.25.0",
    "@types/bun": "latest",
    "@types/turndown": "^5.0.6",
    "@wasm-fmt/clang-format": "^22.1.8",
    "@wasm-fmt/gofmt": "^0.7.3",
    "@wasm-fmt/lua_fmt": "^0.3.3",
    "@wasm-fmt/ruff_fmt": "^0.15.20",
    "@wasm-fmt/taplo_fmt": "^0.2.5",
    "mvdan-sh": "^0.10.1",
    "prettier": "^3.6",
    "sql-formatter": "^15",
    "typescript": "^5"
  }
}
